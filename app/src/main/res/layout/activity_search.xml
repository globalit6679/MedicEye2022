<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/imageView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="#A0C992"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="1.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.0"
        app:srcCompat="@drawable/background" />

    <ImageButton
        android:contentDescription="뒤로 이동합니다"
        android:id="@+id/imageButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:backgroundTint="#A0C992"
        app:layout_constraintBottom_toBottomOf="@+id/imageView"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.04000002"
        app:srcCompat="@drawable/before"
        tools:ignore="SpeakableTextPresentCheck" />

    <ImageButton
        android:contentDescription="메인화면으로 이동합니다"
        android:id="@+id/homeButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:backgroundTint="#A0C992"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="1.0"
        app:layout_constraintStart_toEndOf="@+id/imageButton"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.04000002"
        app:srcCompat="@drawable/home"
        tools:ignore="SpeakableTextPresentCheck" />

    <ImageView
        android:id="@+id/medicImage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/imageView"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="1.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/imageView"
        app:layout_constraintVertical_bias="0.427"
        app:srcCompat="@drawable/coldimage" />

    <ImageButton
        android:contentDescription="복용량을 설명합니다"
        android:id="@+id/doseButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:backgroundTint="#A0C992"
        app:layout_constraintBottom_toBottomOf="@+id/imageView"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/medicImage"
        app:layout_constraintVertical_bias="0.13999999"
        app:srcCompat="@drawable/one_button"
        tools:ignore="SpeakableTextPresentCheck" />

    <TextView
        android:id="@+id/textView9"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="복용량"
        android:importantForAccessibility="no"

        android:focusable="false"
        android:textSize="40dp"
        android:textColor="@color/white"
        app:layout_constraintBottom_toBottomOf="@+id/doseButton"
        app:layout_constraintEnd_toEndOf="@+id/doseButton"
        app:layout_constraintStart_toStartOf="@+id/doseButton"
        app:layout_constraintTop_toTopOf="@+id/doseButton" />

    <ImageButton
        android:contentDescription="주의사항을 설명합니다"
        android:id="@+id/cautionButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:backgroundTint="#A0C992"
        app:layout_constraintBottom_toBottomOf="@+id/imageView"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/doseButton"
        app:layout_constraintVertical_bias="0.26"
        app:srcCompat="@drawable/one_button"
        tools:ignore="SpeakableTextPresentCheck" />

    <TextView
        android:id="@+id/textView10"
        android:importantForAccessibility="no"

        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="주의사항"
        android:textSize="40dp"
        android:focusable="false"
        android:textColor="@color/white"
        app:layout_constraintBottom_toBottomOf="@+id/cautionButton"
        app:layout_constraintEnd_toEndOf="@+id/cautionButton"
        app:layout_constraintStart_toStartOf="@+id/cautionButton"
        app:layout_constraintTop_toTopOf="@+id/cautionButton" />

    <!--보이스 오버가 안 먹힘
    다른 방안-->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/EditInput"
        android:layout_width="250dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toTopOf="@+id/medicImage"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.04"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/imageView"
        app:layout_constraintVertical_bias="0.93"

        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        app:boxStrokeColor="@color/black"
        android:contentDescription="약 이름을 입력해주세요.">
        <EditText
            android:id="@+id/searchInput"
            android:layout_width="250dp"
            android:layout_height="wrap_content"
            android:hint="약 이름"
            android:textColorHint="@color/black"
            android:textColor="@color/black"
            />
    </com.google.android.material.textfield.TextInputLayout>

    <ImageButton
        android:id="@+id/searchButton"
        android:contentDescription="입력한 의약품을 검색합니다"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:backgroundTint="#A0C992"
        app:layout_constraintBottom_toTopOf="@+id/medicImage"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.1"
        app:layout_constraintStart_toEndOf="@+id/EditInput"
        app:layout_constraintTop_toTopOf="@+id/imageView"
        app:layout_constraintVertical_bias="1.0"
        app:srcCompat="@drawable/se"
        tools:ignore="SpeakableTextPresentCheck" />

    <ImageButton
        android:id="@+id/micButton"
        android:contentDescription="음성으로 의약품을 검색합니다"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:backgroundTint="#A0C992"
        app:layout_constraintBottom_toTopOf="@+id/medicImage"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="1.0"
        app:layout_constraintStart_toEndOf="@+id/searchButton"
        app:layout_constraintTop_toBottomOf="@+id/homeButton"
        app:layout_constraintVertical_bias="1.0"
        app:srcCompat="@drawable/voice"
        tools:ignore="SpeakableTextPresentCheck" />

</androidx.constraintlayout.widget.ConstraintLayout>